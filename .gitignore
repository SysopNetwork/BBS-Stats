# ---------------------------------------------------------------------------
# BBS Stats - .gitignore
# Only files required to build, test, document, or deploy the module belong
# in the public repository. Everything below is excluded by default.
# ---------------------------------------------------------------------------

# --- Internal development documents (never publish) ---
MEMORY.MD
PROJECT_STATUS.MD
/PROJECT NOTES/
/Notes/
# Design docs and ADRs stay internal (never in the public repo)
/DOCS/
/NOTES/
/SCRATCH/
/PRIVATE/
/INTERNAL/
/Screenshots/


# --- Credentials / environment-specific config ---
# Ship *.EXAMPLE templates instead of the real files.
*.env
.env
CONFIG.INI
*.local
secrets.*
# Local test-harness config holds a BBS address + account - never publish.
*.LOCAL.INI
# Smoke-test session captures (transient, contain board/account output).
BBSTEST.OUT.*

# --- Visual Studio / MSBuild ---
.vs/
[Dd]ebug/
[Rr]elease/
[Ww]in32/
[Xx]86/
[Bb]in/
[Oo]bj/
ipch/
*.user
*.suo
*.userosscache
*.sln.docstates
*.aps
*.ncb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.opendb
*.pdb
*.idb
*.ilk
*.tlog
*.lastbuildstate
*.obj
*.o
*.exp
*.log

# --- Local machine SDK path (ship MBBSSDK.props.example instead) ---
MBBSSDK.props

# --- Packaged releases (attached to GitHub releases, never committed) ---
/DIST/

# --- Build output (keep the BUILD/ folder, ignore its contents) ---
/BUILD/*
!/BUILD/.gitkeep

# --- Galacticomm / MBBS runtime + tool output (crash dumps, catalogs) ---
GAL*.OUT
*.OUT

# --- Python tooling ---
__pycache__/
*.pyc

# --- Build / temp artifacts ---
*.tmp
*.temp
*.bak
*.swp
~$*
Thumbs.db
desktop.ini
