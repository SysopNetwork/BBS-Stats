/* SNBBSS.rc - Windows version resource for the BBS Stats module DLL.
   The version numbers come from SBVER.H, so they always match the code. */

#include <winver.h>
#include "SBVER.H"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SB_VER_MAJOR,SB_VER_MINOR,SB_VER_PATCH,SB_VER_BUILD
 PRODUCTVERSION SB_VER_MAJOR,SB_VER_MINOR,SB_VER_PATCH,SB_VER_BUILD
 FILEFLAGSMASK 0x3fL
#if SB_PRERELEASE
 FILEFLAGS VS_FF_PRERELEASE
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sysop Network"
            VALUE "FileDescription",  "BBS Stats - The Major BBS v10 statistics module"
            VALUE "FileVersion",      SB_VERSION
            VALUE "InternalName",     "SNBBSS"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Sysop Network"
            VALUE "OriginalFilename", "SNBBSS.DLL"
            VALUE "ProductName",      "BBS Stats"
            VALUE "ProductVersion",   SB_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
